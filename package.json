{
	"name": "n8n-nodes-mastablasta",
	"version": "1.0.0",
	"description": "n8n community node to interface with MastaBlasta API - a multi-platform social media posting service",
	"license": "MIT",
	"homepage": "https://github.com/ewentling/mb-module",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"mastablasta",
		"social media",
		"posting",
		"automation"
	],
	"author": {
		"name": "Eric Wentling",
		"email": ""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ewentling/mb-module.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"prepare": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/MastaBlasta.credentials.js"
		],
		"nodes": [
			"dist/nodes/MastaBlasta/MastaBlasta.node.js"
		]
	},
	"dependencies": {
		"@n8n/node-cli": "^0.17.0",
		"typescript": "^5.9.2"
	},
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.19",
		"eslint": "9.32.0",
		"jest": "^29.7.0",
		"nock": "^13.5.1",
		"prettier": "3.6.2",
		"ts-jest": "^29.1.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
